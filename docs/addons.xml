<?xml version="1.0" encoding="UTF-8"?>
<addons>

<addon id="plugin.video.dynamic_mpd" name="Dynamic MPD Player" version="1.0.0" provider-name="alecl">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="inputstream.adaptive" version="20.3.0" minversion="20.3.0"/>
    <import addon="script.module.requests" version="2.27.1"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="main.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Dynamic MPD Player with ClearKey DRM</summary>
    <summary lang="it_IT">Player MPD Dinamico con DRM ClearKey</summary>
    <description lang="en_GB">Play MPD streams from a dynamic M3U list with inputstream.adaptive support.</description>
    <description lang="it_IT">Riproduci flussi MPD da una lista M3U dinamica con supporto inputstream.adaptive.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>


<addon id="repository.dynamic_mpd" name="Dynamic MPD Repository" version="1.0.0" provider-name="alecl">
  <extension point="xbmc.addon.repository" name="Dynamic MPD Repository">
    <info compressed="false">https://tuousername.github.io/kodi_mpd_addon/addons.xml</info>
    <checksum>https://tuousername.github.io/kodi_mpd_addon/addons.xml.md5</checksum>
    <datadir zip="true">https://tuousername.github.io/kodi_mpd_addon/</datadir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary>Repository for Dynamic MPD Addon</summary>
    <description>Scarica e mantieni aggiornato il plugin Dynamic MPD.</description>
    <platform>all</platform>
  </extension>
</addon>

</addons>
